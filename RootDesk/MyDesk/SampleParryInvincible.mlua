@Component
script SampleParryInvincible extends Component

    @Sync
    property boolean IsParryHeld = false

    @MinValue(0)
    property number ParryDuration = 0.4

    @MinValue(0)
    property number BaseParryStaminaCost = 4

    @MinValue(0)
    property number RapidPressWindowSeconds = 1.0

    @MinValue(0)
    property number RapidPressMultiplier = 1.75

    property string ParryStateName = "ATTACK"

	property string IdleStateName = "IDLE"

	property Vector3 SpawnOffset = Vector3(0.8, 0.6, 0)

	property string ParrySoundRUID = "8e469c0cc3da41f887a060b74440f59f"

	@MinValue(0)
	@MaxValue(1)
	property number ParrySoundVolume = 1.0

    @HideFromInspector
    property number ParryTimerId = 0

    @HideFromInspector
    property number LastParryStartTime = 0

    @HideFromInspector
    property number RapidParryPressCount = 0

	@HideFromInspector
    property Entity ActiveParryModel = nil

    @HideFromInspector
    property number ParryModelTimerId = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        local playerController = self.Entity.PlayerControllerComponent
        if isvalid(playerController) then
            playerController:SetActionKey(KeyboardKey.Mouse1, "SampleParryStart")
            playerController:SetActionKey(KeyboardKey.P, "SampleParryStart")
            log("CLIENT mapped Mouse1/P to SampleParryStart")
        end

		if self.ParrySoundRUID ~= nil and self.ParrySoundRUID ~= "" then
			_ResourceService:PreloadAsync({self.ParrySoundRUID}, nil)
		end
    end

    @ExecSpace("ServerOnly")
    method number GetParryStaminaCost()
        local now = _UtilLogic.ElapsedSeconds
        if self.LastParryStartTime > 0 and now - self.LastParryStartTime <= self.RapidPressWindowSeconds then
            self.RapidParryPressCount = self.RapidParryPressCount + 1
        else
            self.RapidParryPressCount = 1
        end

        self.LastParryStartTime = now

        local cost = math.ceil(self.BaseParryStaminaCost * math.pow(self.RapidPressMultiplier, self.RapidParryPressCount - 1))
        if cost < self.BaseParryStaminaCost then
            cost = self.BaseParryStaminaCost
        end

        return cost
    end

    @ExecSpace("ServerOnly")
    method boolean TryConsumeParryStamina(string source)
        local soulSystem = self.Entity:GetComponent("PlayerSoulSystem")
        if isvalid(soulSystem) == false then
            log("SERVER parry stamina missing PlayerSoulSystem source=" .. tostring(source))
            return false
        end

        local cost = self:GetParryStaminaCost()
        local before = soulSystem.CurrentStamina
        if soulSystem:TryConsumeStamina(cost) == false then
            log("SERVER parry stamina blocked source=" .. tostring(source)
                .. " cost=" .. tostring(cost)
                .. " current=" .. tostring(before))
            return false
        end

        log("SERVER parry stamina consumed source=" .. tostring(source)
            .. " streak=" .. tostring(self.RapidParryPressCount)
            .. " cost=" .. tostring(cost)
            .. " before=" .. tostring(before)
            .. " after=" .. tostring(soulSystem.CurrentStamina))
        return true
    end

	@ExecSpace("Multicast")
	method void MulticastParryFeedback()
		pcall(function()
			_DamageSkinService:PlayTextDamage(self.Entity, "", DamageSkinTextType.Guard, DamageSkinTweenType.Default, Vector2(0, 0.6))
		end)

		if self.ParrySoundRUID ~= nil and self.ParrySoundRUID ~= "" then
			_SoundService:PlaySound(self.ParrySoundRUID, math.max(0, math.min(1, self.ParrySoundVolume)))
		end
	end

	@ExecSpace("ServerOnly")
	method void OnParrySuccess(Entity attacker)
		self:MulticastParryFeedback()

		local immuneLogic = self.Entity:GetComponent("PlayerImmuneLogic")
		if isvalid(immuneLogic) then
			immuneLogic.LastHitTime = _UtilLogic.ElapsedSeconds
		end

		if isvalid(attacker) then
			local monsterRigid = attacker.RigidbodyComponent
			local playerController = self.Entity.PlayerControllerComponent
			if isvalid(monsterRigid) and isvalid(playerController) then
				local pushDir = 1
				if playerController.LookDirectionX ~= 0 then
					pushDir = playerController.LookDirectionX
				end
				monsterRigid:AddForce(Vector2(pushDir * 2, 0.5))
			end
		end

		log("SERVER parry success against attacker=" .. tostring(attacker))
	end

    @ExecSpace("ServerOnly")
    method void EndParry(string source)
        if self.ParryTimerId ~= 0 then
            _TimerService:ClearTimer(self.ParryTimerId)
            self.ParryTimerId = 0
        end

		if self.ParryModelTimerId ~= 0 then
			_TimerService:ClearTimer(self.ParryModelTimerId)
			self.ParryModelTimerId = 0
		end

		if isvalid(self.ActiveParryModel) then
			self.ActiveParryModel:Destroy()
			self.ActiveParryModel = nil
		end

        self.IsParryHeld = false
        log("SERVER parry ended source=" .. tostring(source))
    end

    method void TryChangeState(string stateName)
        if stateName == nil or stateName == "" then
            return
        end

        local stateComponent = self.Entity.StateComponent
        if isvalid(stateComponent) then
            local upper = string.upper(stateName)
            local changed = stateComponent:ChangeState(upper)
            if changed == false and upper ~= "CROUCH" then
                stateComponent:ChangeState("CROUCH")
            end
        end
    end

	@ExecSpace("ServerOnly")
    method void SpawnParryModel()
        local modelId = _EntryService:GetModelIdByName("Model_Parry")
        if modelId == nil or modelId == "" then
            log("SampleParryInvincible SpawnParryModel: Model_Parry not found")
            return
        end

        local playerController = self.Entity.PlayerControllerComponent
        local lookDirectionX = 1
        if isvalid(playerController) then
            lookDirectionX = playerController.LookDirectionX
            if lookDirectionX == 0 then
                lookDirectionX = 1
            end
        end

        local transform = self.Entity.TransformComponent
        if isvalid(transform) == false then
            log("SampleParryInvincible SpawnParryModel: TransformComponent missing")
            return
        end

		local spawnPosition = transform.WorldPosition + Vector3(lookDirectionX * self.SpawnOffset.x, self.SpawnOffset.y, self.SpawnOffset.z)

        if isvalid(self.ActiveParryModel) then
            self.ActiveParryModel:Destroy()
            self.ActiveParryModel = nil
        end

        local parryModel = _SpawnService:SpawnByModelId(modelId, "Model_Parry", spawnPosition, self.Entity.Parent)
        if isvalid(parryModel) == false then
            log("SampleParryInvincible SpawnParryModel: spawn failed")
            return
        end

        self.ActiveParryModel = parryModel
        parryModel.Enable = true
        parryModel.TransformComponent.WorldPosition = spawnPosition

        if self.ParryModelTimerId ~= 0 then
            _TimerService:ClearTimer(self.ParryModelTimerId)
            self.ParryModelTimerId = 0
        end

        self.ParryModelTimerId = _TimerService:SetTimerOnce(function()
            if isvalid(self.ActiveParryModel) then
                self.ActiveParryModel:Destroy()
                self.ActiveParryModel = nil
            end
            self.ParryModelTimerId = 0
        end, self.ParryDuration)
    end

    @ExecSpace("ServerOnly")
    method void StartParry(string source)
        if self:TryConsumeParryStamina(source) == false then
            return
        end

        if self.ParryTimerId ~= 0 then
            _TimerService:ClearTimer(self.ParryTimerId)
            self.ParryTimerId = 0
        end

        self.IsParryHeld = true
        self:TryChangeState(self.ParryStateName)
		self:SpawnParryModel()
        log("SERVER parry started source=" .. tostring(source))

        self.ParryTimerId = _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) == false then
                return
            end
            self:EndParry("TimerEnd")
        end, self.ParryDuration)
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandlePlayerActionEvent(PlayerActionEvent event)
        log("SERVER action=" .. tostring(event.ActionName))
        if event.ActionName == "SampleParryStart" then
            self:StartParry("SampleParryStart")
        end
    end

    @ExecSpace("ServerOnly")
    method void OnDestroy()
        self.RapidParryPressCount = 0
        self.LastParryStartTime = 0
        self:EndParry("OnDestroy")
    end

end