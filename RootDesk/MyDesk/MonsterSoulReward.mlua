@Component
script MonsterSoulReward extends Component

	@Sync
	property number SoulsToGive = 10

	@Description("Persistent Echo Shards granted directly to the killer's permanent wallet, in addition to run Souls")
	@Sync
	property number EchoShardsToGive = 10

	method Entity FindSoulOwner(Entity attacker)
		local current = attacker
		while isvalid(current) do
			if isvalid(current:GetComponent("PlayerSoulSystem")) then
				return current
			end
			current = current.Parent
		end

		if attacker.OwnerId ~= nil and attacker.OwnerId ~= "" then
			local ownerEntity = _UserService:GetUserEntityByUserId(attacker.OwnerId)
			if isvalid(ownerEntity) and isvalid(ownerEntity:GetComponent("PlayerSoulSystem")) then
				return ownerEntity
			end
		end

		return nil
	end

	@ExecSpace("ServerOnly")
	method void GrantSoulsToPlayer(Entity attacker)
		if attacker == nil then
			log("MonsterSoulReward GrantSoulsToPlayer: attacker is nil")
			return
		end

		local soulOwner = self:FindSoulOwner(attacker)
		if isvalid(soulOwner) then
			local playerSoulSystem = soulOwner:GetComponent("PlayerSoulSystem")
			playerSoulSystem:AddSouls(self.SoulsToGive)
			log("MonsterSoulReward GrantSoulsToPlayer: granted " .. tostring(self.SoulsToGive) .. " to " .. tostring(soulOwner))

			local runManager = soulOwner:GetComponent("RogueliteRunManager")
			local playerComponent = soulOwner:GetComponent("PlayerComponent")
			if isvalid(runManager) and isvalid(playerComponent) and self.EchoShardsToGive > 0 then
				runManager:DepositToSoulBank(playerComponent.UserId, self.EchoShardsToGive)
			end
			return
		end

		log("MonsterSoulReward GrantSoulsToPlayer: PlayerSoulSystem not found for attacker " .. tostring(attacker) .. " parent=" .. tostring(attacker.Parent))
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		local attackerEntity = event.AttackerEntity
		if attackerEntity == nil then
			log("MonsterSoulReward HandleHitEvent: attackerEntity is nil")
			return
		end

		local monsterComponent = self.Entity:GetComponent("Monster")
		if not isvalid(monsterComponent) then
			return
		end

		if monsterComponent.Hp > 0 then
			return
		end

		self:GrantSoulsToPlayer(attackerEntity)
	end

end
