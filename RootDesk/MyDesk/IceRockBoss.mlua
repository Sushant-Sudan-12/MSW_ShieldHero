@Component
script IceRockBoss extends AttackComponent

	property string BossDisplayName = "Ice Rock Boss"

	property string BossTag = "IceRockBoss"

	property string RequiredMiniBossTag = "MiniIceBoss"

	@MinValue(1)
	property integer RequiredMiniBossCount = 4

	@Sync
	property boolean DamageUnlocked = false

	@Sync
	property number BossMaxHp = 2100

	@Sync
	property number BossCurrentHp = 2100

	@Sync
	property boolean IsBossDead = false

	-- The boss remains stationary and only turns toward the nearest player.
	property boolean FaceNearestPlayerEnabled = true

	@MinValue(0.1)
	property number DetectionRangeX = 20.0

	@MinValue(0.1)
	property number DetectionRangeY = 10.0

	-- 360-degree projectile ring
	property string ProjectileModelName = "Model_Projectile"

	@MinValue(1)
	property integer ProjectileCount = 10

	property boolean RandomizeProjectileCount = true

	@MinValue(1)
	property integer ProjectileCountMin = 12

	@MinValue(1)
	property integer ProjectileCountMax = 18

	@MinValue(0.0)
	property number ProjectileRingRotationDegrees = 360.0

	@MinValue(0.0)
	property number ProjectileAngleJitterDegrees = 5.0

	@MinValue(0)
	property number ProjectileSpeed = 6.0

	@MinValue(0)
	property integer ProjectileDamage = 15

	@MinValue(0.1)
	property number ProjectileLifetime = 3.0

	@MinValue(0.1)
	property number ProjectileScale = 1.0

	@MinValue(0.1)
	property number AttackInterval = 3.0

	@MinValue(0.1)
	property number BossFightAttackInterval = 1.8

	@MinValue(0.1)
	property number BossFightProjectileSpeedMultiplier = 1.25

	@MinValue(0.0)
	property number ProjectileTelegraphDelay = 1.0

	@MinValue(0.0)
	property number AttackWindup = 0.4

	property Vector2 ProjectileSpawnOffset = Vector2(0, 0)

	property string BossFightBgmRUID = ""

	@MinValue(0.0)
	property number BossFightBgmVolume = 1

	property string ProjectileFireSoundRUID = ""

	@MinValue(0.0)
	property number ProjectileFireSoundVolume = 1

	@MinValue(0.0)
	property number ProjectileFireSoundPitch = 1

	property boolean EnablePhaseRelocation = true

	@MinValue(1)
	property integer PhaseThreshold1Percent = 75

	@MinValue(1)
	property integer PhaseThreshold2Percent = 60

	@MinValue(1)
	property integer PhaseThreshold3Percent = 45

	@MinValue(1)
	property integer PhaseThreshold4Percent = 30

	@MinValue(1)
	property integer CenterReturnThresholdPercent = 15

	property Vector3 PhaseLocation1 = Vector3(0, 0, 0)

	property Vector3 PhaseLocation2 = Vector3(0, 0, 0)

	property Vector3 PhaseLocation3 = Vector3(0, 0, 0)

	property Vector3 PhaseLocation4 = Vector3(0, 0, 0)

	property Vector3 CenterSpawnLocation = Vector3(0, 0, 0)

	property boolean ReturnToSpawnOnDeath = true

	property boolean KillTaggedMonstersOnDeath = true

	property string KillOnDeathMonsterTag = "Monster"

	property boolean InvertFacingDirection = false

	property boolean DisableNativeWander = true

	property boolean DisableNativeStateAnimation = true

	property boolean EnableHitDamagePopup = true

	property string DamageSkinId = ""

	@MinValue(0.0)
	property number DamagePopupOffsetY = 0.5

	@MinValue(0.0)
	property number DeathHideDelay = 2.0

	property boolean DebugLogs = false

	@HideFromInspector
	property number LastAttackTime = -9999

	@HideFromInspector
	property number ActiveAttackToken = 0

	@HideFromInspector
	property boolean IsAttacking = false

	@HideFromInspector
	property integer DefeatedMiniBossCount = 0

	@HideFromInspector
	property number PendingDamage = 0

	@HideFromInspector
	property boolean BossFightStarted = false

	@HideFromInspector
	property Vector3 SpawnPosition = Vector3(0, 0, 0)

	@HideFromInspector
	property integer NextPhaseThresholdPercent = 50

	@HideFromInspector
	property integer PhaseRelocationCount = 0

	@HideFromInspector
	property boolean PhaseLocation1Used = false

	@HideFromInspector
	property boolean PhaseLocation2Used = false

	@HideFromInspector
	property boolean PhaseLocation3Used = false

	@HideFromInspector
	property boolean PhaseLocation4Used = false

	@HideFromInspector
	property boolean CenterRelocationDone = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:EnsureBossTag()
		self:ResetBossForMapLoad()

		local transform = self.Entity.TransformComponent
		if isvalid(transform) then
			self.SpawnPosition = transform.WorldPosition
			if self.CenterSpawnLocation.x == 0 and self.CenterSpawnLocation.y == 0 and self.CenterSpawnLocation.z == 0 then
				self.CenterSpawnLocation = transform.WorldPosition
			end
		end

		if self.DisableNativeWander then
			local wander = self.Entity.AIWanderComponent
			if isvalid(wander) then
				wander.Enable = false
			end
		end

		if self.DisableNativeStateAnimation then
			local stateAnimation = self.Entity:GetComponent("StateAnimationComponent")
			if isvalid(stateAnimation) then
				stateAnimation.Enable = false
			end
		end

		self.DamageUnlocked = false
		self:RefreshDamageLock()

		if self.DebugLogs then
			log("IceRockBoss ready hp=" .. tostring(self.BossCurrentHp) .. "/" .. tostring(self.BossMaxHp)
				.. " requiredMiniBosses=" .. tostring(self.RequiredMiniBossCount))
		end
	end

	@ExecSpace("ServerOnly")
	method void ResetBossForMapLoad()
		self.BossCurrentHp = math.max(0, self.BossMaxHp)
		self.IsBossDead = false
		self.ActiveAttackToken = 0
		self.IsAttacking = false
		self.LastAttackTime = -9999
		self.PendingDamage = 0
		self.BossFightStarted = false
		self:ResetPhaseRelocations()
	end

	@ExecSpace("ServerOnly")
	method void ResetBossForRun()
		self.BossCurrentHp = math.max(0, self.BossMaxHp)
		self.IsBossDead = false
		self.DamageUnlocked = false
		self.ActiveAttackToken = self.ActiveAttackToken + 1
		self.IsAttacking = false
		self.LastAttackTime = -9999
		self.PendingDamage = 0
		self.BossFightStarted = false
		self:ResetPhaseRelocations()
		local transform = self.Entity.TransformComponent
		if isvalid(transform) then
			transform.WorldPosition = self.SpawnPosition
		end
		self.Entity:SetVisible(true)
		self.Entity:SetEnable(true)
		self:RefreshDamageLock()
	end

	method void ResetPhaseRelocations()
		self.NextPhaseThresholdPercent = self.PhaseThreshold1Percent
		self.PhaseRelocationCount = 0
		self.PhaseLocation1Used = false
		self.PhaseLocation2Used = false
		self.PhaseLocation3Used = false
		self.PhaseLocation4Used = false
		self.CenterRelocationDone = false
	end

	method void EnsureBossTag()
		if self.BossTag == nil or self.BossTag == "" then
			return
		end

		local tagComponent = self.Entity:GetComponent("TagComponent")
		if isvalid(tagComponent) == false then
			tagComponent = self.Entity:AddComponent("TagComponent")
		end

		if isvalid(tagComponent) then
			tagComponent:AddTag(self.BossTag)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self.IsBossDead then
			return
		end

		self:RefreshDamageLock()
		self:FaceNearestPlayer()
		self:UpdatePhaseRelocation()

		if self.IsAttacking then
			return
		end

		local detection = self:FindNearestPlayer(self.Entity.TransformComponent.WorldPosition)
		if detection.Player == nil or detection.Distance > self.DetectionRangeX or math.abs(detection.DeltaY) > self.DetectionRangeY then
			return
		end

		local now = _UtilLogic.ElapsedSeconds
		if now - self.LastAttackTime >= self:GetCurrentAttackInterval() then
			self:StartProjectileAttack()
		end
	end

	method void RefreshDamageLock()
		local miniBosses = _EntityService:GetEntitiesByTag(self.RequiredMiniBossTag)
		local defeated = 0
		local total = 0

		if miniBosses ~= nil then
			for _, entity in ipairs(miniBosses) do
				if isvalid(entity) then
					total = total + 1
					local monster = entity:GetComponent("Monster")
					local miniBoss = entity:GetComponent("BossAI")
					local miniDead = false
					if isvalid(monster) then
						miniDead = monster.IsDead
					elseif isvalid(miniBoss) then
						miniDead = miniBoss.IsBossDead
					end
					if miniDead then
						defeated = defeated + 1
					end
				end
			end
		end

		self.DefeatedMiniBossCount = defeated
		local wasUnlocked = self.DamageUnlocked
		self.DamageUnlocked = defeated >= self.RequiredMiniBossCount
		if self.DamageUnlocked and wasUnlocked == false then
			self:StartBossFight()
		end

		if self.DebugLogs and wasUnlocked ~= self.DamageUnlocked then
			log("IceRockBoss damage lock changed unlocked=" .. tostring(self.DamageUnlocked)
				.. " defeated=" .. tostring(defeated) .. "/" .. tostring(self.RequiredMiniBossCount)
				.. " tagged=" .. tostring(total))
		end
	end

	method void StartBossFight()
		if self.BossFightStarted then
			return
		end

		self.BossFightStarted = true
		self:MulticastPlayBossFightBgm()
		if self.DebugLogs then
			log("IceRockBoss boss fight started")
		end
	end

	method number GetCurrentAttackInterval()
		if self.BossFightStarted then
			return math.max(0.1, self.BossFightAttackInterval)
		end

		return math.max(0.1, self.AttackInterval)
	end

	method number GetCurrentProjectileSpeed()
		local speed = math.max(0, self.ProjectileSpeed)
		if self.BossFightStarted then
			speed = speed * math.max(0.1, self.BossFightProjectileSpeedMultiplier)
		end

		return speed
	end

	method void UpdatePhaseRelocation()
		if self.EnablePhaseRelocation == false or self.BossFightStarted == false or self.IsBossDead then
			return
		end

		local hpPercent = self:GetHpRatio() * 100
		if self.CenterRelocationDone == false and hpPercent <= self.CenterReturnThresholdPercent then
			self.CenterRelocationDone = true
			self:MoveToCenterSpawnLocation()
			return
		end

		if self.PhaseRelocationCount >= 4 then
			return
		end

		if hpPercent > self.NextPhaseThresholdPercent then
			return
		end

		local nextLocation = self:GetRandomUnusedPhaseLocation()
		if nextLocation ~= nil then
			self:MoveToPhaseLocation(nextLocation)
		end

		self.PhaseRelocationCount = self.PhaseRelocationCount + 1
		self.NextPhaseThresholdPercent = self:GetPhaseThresholdByIndex(self.PhaseRelocationCount + 1)
	end

	method integer GetPhaseThresholdByIndex(integer index)
		if index == 1 then
			return self.PhaseThreshold1Percent
		elseif index == 2 then
			return self.PhaseThreshold2Percent
		elseif index == 3 then
			return self.PhaseThreshold3Percent
		elseif index == 4 then
			return self.PhaseThreshold4Percent
		end

		return 0
	end

	method Vector3 GetRandomUnusedPhaseLocation()
		local choices = {}
		if self.PhaseLocation1Used == false then
			table.insert(choices, 1)
		end
		if self.PhaseLocation2Used == false then
			table.insert(choices, 2)
		end
		if self.PhaseLocation3Used == false then
			table.insert(choices, 3)
		end
		if self.PhaseLocation4Used == false then
			table.insert(choices, 4)
		end

		if #choices <= 0 then
			return nil
		end

		local choiceIndex = 1 + math.floor(_UtilLogic:RandomDouble() * #choices)
		local choice = choices[choiceIndex]
		if choice == 1 then
			self.PhaseLocation1Used = true
			return self.PhaseLocation1
		elseif choice == 2 then
			self.PhaseLocation2Used = true
			return self.PhaseLocation2
		elseif choice == 3 then
			self.PhaseLocation3Used = true
			return self.PhaseLocation3
		else
			self.PhaseLocation4Used = true
			return self.PhaseLocation4
		end
	end

	method void MoveToPhaseLocation(Vector3 position)
		local transform = self.Entity.TransformComponent
		if isvalid(transform) == false then
			return
		end

		transform.WorldPosition = position
		self.ActiveAttackToken = self.ActiveAttackToken + 1
		self.IsAttacking = false
		if self.DebugLogs then
			log("IceRockBoss moved to phase location " .. tostring(self.PhaseRelocationCount + 1))
		end
	end

	method void MoveToCenterSpawnLocation()
		local transform = self.Entity.TransformComponent
		if isvalid(transform) == false then
			return
		end

		transform.WorldPosition = self.CenterSpawnLocation
		self.ActiveAttackToken = self.ActiveAttackToken + 1
		self.IsAttacking = false
		if self.DebugLogs then
			log("IceRockBoss moved to center spawn location")
		end
	end

	method void FaceNearestPlayer()
		if self.FaceNearestPlayerEnabled == false then
			return
		end

		local transform = self.Entity.TransformComponent
		if isvalid(transform) == false then
			return
		end

		local info = self:FindNearestPlayer(transform.WorldPosition)
		if info.Player == nil or info.Distance > self.DetectionRangeX or math.abs(info.DeltaY) > self.DetectionRangeY then
			return
		end

		local playerPos = info.Player.TransformComponent.WorldPosition
		local direction = (playerPos.x >= transform.WorldPosition.x) and 1 or -1
		self:SetFaceDirection(direction)
	end

	method void StartProjectileAttack()
		self.IsAttacking = true
		self.ActiveAttackToken = self.ActiveAttackToken + 1
		local token = self.ActiveAttackToken
		self.LastAttackTime = _UtilLogic.ElapsedSeconds

		local windup = math.max(self.AttackWindup, 0)
		if windup <= 0 then
			self:FireProjectileRing(token)
			self.IsAttacking = false
			return
		end

		_TimerService:SetTimerOnce(function()
			if isvalid(self.Entity) == false or self.ActiveAttackToken ~= token or self.IsBossDead then
				return
			end
			self:FireProjectileRing(token)
			self.IsAttacking = false
		end, windup)
	end

	method void FireProjectileRing(number token)
		if self.ActiveAttackToken ~= token or self.IsBossDead then
			return
		end

		self:MulticastPlayProjectileFireSound()

		local transform = self.Entity.TransformComponent
		if isvalid(transform) == false then
			return
		end

		local modelId = _EntryService:GetModelIdByName(self.ProjectileModelName)
		if modelId == nil or modelId == "" then
			log("IceRockBoss ERROR: projectile model not found: " .. tostring(self.ProjectileModelName))
			return
		end

		local spawnPos = Vector3(
			transform.WorldPosition.x + self.ProjectileSpawnOffset.x,
			transform.WorldPosition.y + self.ProjectileSpawnOffset.y,
			transform.WorldPosition.z
		)
		local count = math.max(1, self.ProjectileCount)
		if self.RandomizeProjectileCount then
			local minimumCount = math.max(1, math.floor(self.ProjectileCountMin))
			local maximumCount = math.max(minimumCount, math.floor(self.ProjectileCountMax))
			count = minimumCount + math.floor(_UtilLogic:RandomDouble() * (maximumCount - minimumCount + 1))
		end

		local angleStep = (math.pi * 2) / count
		local rotationRange = math.max(0, self.ProjectileRingRotationDegrees)
		local ringRotation = 0
		if rotationRange > 0 then
			ringRotation = (_UtilLogic:RandomDouble() - 0.5) * math.rad(rotationRange)
		end
		local jitterRange = math.max(0, self.ProjectileAngleJitterDegrees)

		for index = 0, count - 1 do
			local jitter = 0
			if jitterRange > 0 then
				jitter = (_UtilLogic:RandomDouble() - 0.5) * 2 * math.rad(jitterRange)
			end
			local angle = ringRotation + (index * angleStep) + jitter
			self:SpawnProjectile(modelId, spawnPos, math.cos(angle), math.sin(angle))
		end

		if self.DebugLogs then
			log("IceRockBoss fired 360 ring count=" .. tostring(count))
		end
	end

	method void SpawnProjectile(string modelId, Vector3 spawnPos, number directionX, number directionY)
		local projectile = _SpawnService:SpawnByModelId(modelId, "IceRockProjectile", spawnPos, self.Entity.Parent)
		if isvalid(projectile) == false then
			if self.DebugLogs then
				log("IceRockBoss ERROR: projectile spawn failed")
			end
			return
		end

		projectile.Enable = true
		local projectileTransform = projectile.TransformComponent
		if isvalid(projectileTransform) then
			projectileTransform.WorldPosition = spawnPos
			projectileTransform.Scale = Vector3(self.ProjectileScale, self.ProjectileScale, 1)
			projectileTransform.ZRotation = math.deg(self:Atan2(directionY, directionX))
		end

		local needle = projectile:GetComponent("NeedleProjectile")
		if isvalid(needle) then
			needle.Speed = self:GetCurrentProjectileSpeed()
			needle.DirectionX = directionX
			needle.DirectionY = directionY
			needle.Lifetime = self.ProjectileLifetime
			needle.LaunchDelay = self.ProjectileTelegraphDelay
			needle.NeedleDamage = self.ProjectileDamage
		elseif self.DebugLogs then
			log("IceRockBoss ERROR: projectile model needs NeedleProjectile component")
		end
	end

	method number Atan2(number y, number x)
		if x > 0 then
			return math.atan(y / x)
		elseif x < 0 then
			if y >= 0 then
				return math.atan(y / x) + math.pi
			else
				return math.atan(y / x) - math.pi
			end
		elseif y > 0 then
			return math.pi / 2
		elseif y < 0 then
			return -math.pi / 2
		end
		return 0
	end

	method any FindNearestPlayer(Vector3 myPos)
		local nearestPlayer = nil
		local minDistance = 999999
		local targetDy = 0
		local users = _UserService.UserEntities
		if users ~= nil then
			for _, player in pairs(users) do
				if isvalid(player) and isvalid(player.PlayerComponent) and isvalid(player.TransformComponent) then
					local playerPos = player.TransformComponent.WorldPosition
					local dx = math.abs(playerPos.x - myPos.x)
					if dx < minDistance then
						minDistance = dx
						nearestPlayer = player
						targetDy = playerPos.y - myPos.y
					end
				end
			end
		end
		return {Player = nearestPlayer, Distance = minDistance, DeltaY = targetDy}
	end

	method number GetHpRatio()
		if self.BossMaxHp <= 0 then
			return 0
		end

		return math.max(0, math.min(1, self.BossCurrentHp / self.BossMaxHp))
	end

	method void SetFaceDirection(number direction)
		if direction == 0 then
			return
		end
		local spriteRenderer = self.Entity.SpriteRendererComponent
		if isvalid(spriteRenderer) then
			local faceLeft = direction < 0
			if self.InvertFacingDirection then
				faceLeft = not faceLeft
			end
			spriteRenderer.FlipX = not faceLeft
		end
	end

	@ExecSpace("ServerOnly")
	method void KillTaggedMonsters()
		if self.KillTaggedMonstersOnDeath == false or self.KillOnDeathMonsterTag == nil or self.KillOnDeathMonsterTag == "" then
			return
		end

		local monsters = _EntityService:GetEntitiesByTag(self.KillOnDeathMonsterTag)
		if monsters == nil then
			return
		end

		for _, entity in ipairs(monsters) do
			if isvalid(entity) and entity ~= self.Entity then
				local monster = entity:GetComponent("Monster")
				if isvalid(monster) then
					monster:PreventRespawn()
					if monster.IsDead == false then
						monster:Dead()
					end
				else
					local boss = entity:GetComponent("BossAI")
					if isvalid(boss) and boss.IsBossDead == false then
						boss:KillBoss()
					end
				end
			end
		end
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		return math.floor(self.PendingDamage)
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		if self.DamageUnlocked == false or isvalid(defender) == false or isvalid(defender.PlayerComponent) == false then
			return false
		end
		return __base:IsAttackTarget(defender, attackInfo)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		if self.IsBossDead or self.DamageUnlocked == false then
			return
		end

		self.BossCurrentHp = math.max(0, self.BossCurrentHp - event.TotalDamage)
		self:PlayBossHitFeedback(event.TotalDamage)
		if self.DebugLogs then
			log("IceRockBoss took " .. tostring(event.TotalDamage) .. " hp=" .. tostring(self.BossCurrentHp))
		end

		if self.BossCurrentHp <= 0 then
			self.IsBossDead = true
			self.ActiveAttackToken = self.ActiveAttackToken + 1
			self.IsAttacking = false
			self:KillTaggedMonsters()
			if self.ReturnToSpawnOnDeath then
				self:MoveToCenterSpawnLocation()
			end

			_TimerService:SetTimerOnce(function()
				if isvalid(self.Entity) == false then
					return
				end
				self.Entity:SetVisible(false)
				self.Entity:SetEnable(false)
			end, self.DeathHideDelay)
		end
	end

	method void PlayBossHitFeedback(integer damage)
		if self.EnableHitDamagePopup == false or damage <= 0 then
			return
		end

		pcall(function()
			local spawner = self.Entity:GetComponent("DamageSkinSpawnerComponent")
			if isvalid(spawner) == false then
				self.Entity:AddComponent("DamageSkinSpawnerComponent")
			end

			local skinId = self.DamageSkinId
			if skinId == nil then
				skinId = ""
			end

			local setting = self.Entity:GetComponent("DamageSkinSettingComponent")
			if skinId == "" and isvalid(setting) and setting.DamageSkinId ~= nil then
				skinId = tostring(setting.DamageSkinId)
			end

			_DamageSkinService:Play(
				self.Entity,
				skinId,
				0,
				{math.floor(damage)},
				DamageSkinTweenType.DefaultMini,
				false,
				Vector2(0, self.DamagePopupOffsetY),
				Vector2(1, 1),
				1,
				1
			)
		end)
	end

	@ExecSpace("Multicast")
	method void MulticastPlayBossFightBgm()
		if self.BossFightBgmRUID == nil or self.BossFightBgmRUID == "" then
			return
		end

		_SoundService:PlayBGM(self.BossFightBgmRUID, math.max(0, math.min(1, self.BossFightBgmVolume)))
	end

	@ExecSpace("Multicast")
	method void MulticastPlayProjectileFireSound()
		if self.ProjectileFireSoundRUID == nil or self.ProjectileFireSoundRUID == "" then
			return
		end

		_SoundService:PlaySound(self.ProjectileFireSoundRUID, math.max(0, math.min(1, self.ProjectileFireSoundVolume)))
	end

end
