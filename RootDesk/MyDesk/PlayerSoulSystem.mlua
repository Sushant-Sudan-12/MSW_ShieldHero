@Component
script PlayerSoulSystem extends Component

	@Sync
	property number TotalSouls = 0

	@Sync
	property number HealthLevel = 1

	@Sync
	property number StaminaLevel = 1

	@Sync
	property number AttackLevel = 1

	@Sync
	property number HealthUpgradePercent = 20

	@Sync
	property number StaminaUpgradePercent = 20

	@Sync
	property number AttackUpgradePercent = 20

	-- === Permanent (Echo Shard) Upgrade Bonuses - persist across runs/deaths ===
	@Sync
	property number PermanentHealthBonusPercent = 0

	@Sync
	property number PermanentStaminaBonusPercent = 0

	@Sync
	property number PermanentAttackBonusPercent = 0

	@Sync
	property number BaseMaxStamina = 100

	@Sync
	property number CurrentStamina = 100

	@Sync
	property number ShieldThrowStaminaCost = 25

	@Sync
	property number StaminaRegenPerSecond = 2

	@Sync
	property boolean InputLocked = false

	@MinValue(1)
	property number DefaultMaxHp = 120

	@HideFromInspector
	property number CachedWalkSpeed = -1

	@HideFromInspector
	property number CachedWalkJump = -1

	@HideFromInspector
	property number BaseMaxHp = 0

	@HideFromInspector
	property number LastRegenTime = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		local playerComponent = self.Entity:GetComponent("PlayerComponent")
		if isvalid(playerComponent) then
			-- BaseMaxHp is the true default, never the upgraded value
			self.BaseMaxHp = self.DefaultMaxHp
			-- Never spawn inflated: compute from levels but clamp to what levels should allow
			local maxAllowed = math.floor(self.DefaultMaxHp * self:GetHealthMultiplier())
			playerComponent.MaxHp = maxAllowed
			playerComponent.Hp = playerComponent.MaxHp
		end

		self.CurrentStamina = self:GetMaxStamina()
		self.LastRegenTime = _UtilLogic.ElapsedSeconds
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		self:RegenerateStamina()
	end

	method void AddSouls(number amount)
		if amount == nil or amount <= 0 then
			log("PlayerSoulSystem AddSouls ignored amount=" .. tostring(amount))
			return
		end

		local before = self.TotalSouls
		self.TotalSouls = self.TotalSouls + amount
		log("PlayerSoulSystem AddSouls: before=" .. tostring(before) .. " amount=" .. tostring(amount) .. " after=" .. tostring(self.TotalSouls))
	end

	method number GetTotalSouls()
		return self.TotalSouls
	end

	method string GetSoulText()
		return "x" .. tostring(self.TotalSouls)
	end

	method number GetHealthMultiplier()
		return 1 + ((self.HealthLevel - 1) * (self.HealthUpgradePercent / 100)) + (self.PermanentHealthBonusPercent / 100)
	end

	method number GetStaminaMultiplier()
		return 1 + ((self.StaminaLevel - 1) * (self.StaminaUpgradePercent / 100)) + (self.PermanentStaminaBonusPercent / 100)
	end

	method number GetAttackMultiplier()
		return 1 + ((self.AttackLevel - 1) * (self.AttackUpgradePercent / 100)) + (self.PermanentAttackBonusPercent / 100)
	end

	method number GetMaxStamina()
		return self.BaseMaxStamina * self:GetStaminaMultiplier()
	end

	method number GetStaminaRatio()
		local maxStamina = self:GetMaxStamina()
		if maxStamina <= 0 then
			return 0
		end

		local ratio = self.CurrentStamina / maxStamina
		return math.max(0, math.min(1, ratio))
	end

	method boolean HasEnoughStamina(number cost)
		return self.CurrentStamina >= cost
	end

	@ExecSpace("ServerOnly")
	method boolean TryConsumeStamina(number cost)
		if cost <= 0 then
			return true
		end

		if self:HasEnoughStamina(cost) == false then
			return false
		end

		self.CurrentStamina = math.max(0, self.CurrentStamina - cost)
		return true
	end

	@ExecSpace("ServerOnly")
	method void RegenerateStamina()
		local maxStamina = self:GetMaxStamina()
		if maxStamina <= 0 then
			return
		end

		if self.CurrentStamina >= maxStamina then
			self.CurrentStamina = maxStamina
			self.LastRegenTime = _UtilLogic.ElapsedSeconds
			return
		end

		local now = _UtilLogic.ElapsedSeconds
		local delta = now - self.LastRegenTime
		if delta <= 0 then
			return
		end

		self.LastRegenTime = now
		self.CurrentStamina = math.min(maxStamina, self.CurrentStamina + (self.StaminaRegenPerSecond * delta))
	end

	method void IncreaseHealth()
		local beforeLevel = self.HealthLevel
		local beforeMaxHp = 0
		local beforeHp = 0

		local beforePlayerComponent = self.Entity:GetComponent("PlayerComponent")
		if isvalid(beforePlayerComponent) then
			beforeMaxHp = beforePlayerComponent.MaxHp
			beforeHp = beforePlayerComponent.Hp
		end

		self.HealthLevel = self.HealthLevel + 1

		local playerComponent = self.Entity:GetComponent("PlayerComponent")
		if isvalid(playerComponent) == false then
			return
		end

		-- Always base upgrades on the immutable default, never the inflated value
		self.BaseMaxHp = self.DefaultMaxHp
		local newMaxHp = math.floor(self.BaseMaxHp * self:GetHealthMultiplier())
		if newMaxHp < 1 then
			newMaxHp = 1
		end
		playerComponent.MaxHp = newMaxHp
		playerComponent.Hp = newMaxHp

		log("PlayerSoulSystem IncreaseHealth: level " .. tostring(beforeLevel) .. " -> " .. tostring(self.HealthLevel)
			.. " maxHp " .. tostring(beforeMaxHp) .. " -> " .. tostring(playerComponent.MaxHp)
			.. " hp " .. tostring(beforeHp) .. " -> " .. tostring(playerComponent.Hp))
	end

	method void IncreaseStamina()
		local beforeLevel = self.StaminaLevel
		local beforeCurrent = self.CurrentStamina
		local beforeMax = self:GetMaxStamina()
		self.StaminaLevel = self.StaminaLevel + 1
		self.CurrentStamina = self:GetMaxStamina()
		log("PlayerSoulSystem IncreaseStamina: level " .. tostring(beforeLevel) .. " -> " .. tostring(self.StaminaLevel)
			.. " max " .. tostring(beforeMax) .. " -> " .. tostring(self:GetMaxStamina())
			.. " current " .. tostring(beforeCurrent) .. " -> " .. tostring(self.CurrentStamina))
	end

	method void IncreaseAttack()
		local beforeLevel = self.AttackLevel
		self.AttackLevel = self.AttackLevel + 1
		log("PlayerSoulSystem IncreaseAttack: level " .. tostring(beforeLevel) .. " -> " .. tostring(self.AttackLevel))
	end

	-- Called by RogueliteRunManager after an Echo Shard permanent upgrade purchase; never reset on death
	@ExecSpace("ServerOnly")
	method void ApplyPermanentHealthBonus(number percent)
		self.PermanentHealthBonusPercent = percent

		local playerComponent = self.Entity:GetComponent("PlayerComponent")
		if isvalid(playerComponent) == false then
			return
		end

		self.BaseMaxHp = self.DefaultMaxHp
		local newMaxHp = math.floor(self.BaseMaxHp * self:GetHealthMultiplier())
		if newMaxHp < 1 then
			newMaxHp = 1
		end
		playerComponent.MaxHp = newMaxHp
		if playerComponent.Hp > newMaxHp then
			playerComponent.Hp = newMaxHp
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyPermanentStaminaBonus(number percent)
		self.PermanentStaminaBonusPercent = percent
		self.CurrentStamina = self:GetMaxStamina()
	end

	@ExecSpace("ServerOnly")
	method void ApplyPermanentAttackBonus(number percent)
		self.PermanentAttackBonusPercent = percent
	end

	@ExecSpace("ServerOnly")
	method void ResetRunUpgrades()
		self.TotalSouls = 0
		self.HealthLevel = 1
		self.StaminaLevel = 1
		self.AttackLevel = 1

		local playerComponent = self.Entity:GetComponent("PlayerComponent")
		if isvalid(playerComponent) then
			self.BaseMaxHp = self.DefaultMaxHp
			playerComponent.MaxHp = math.floor(self.DefaultMaxHp)
			playerComponent.Hp = playerComponent.MaxHp
		end

		self.CurrentStamina = self:GetMaxStamina()
		log("PlayerSoulSystem ResetRunUpgrades: levels->1, MaxHp->" .. tostring(self.DefaultMaxHp))
	end

	@EventSender("Self")
	handler HandleUpgradeRequestEvent(UpgradeRequestEvent event)
		local upgradeType = event.UpgradeType
		log("PlayerSoulSystem HandleUpgradeRequestEvent: received type=" .. tostring(upgradeType)
			.. " current H=" .. tostring(self.HealthLevel)
			.. " S=" .. tostring(self.StaminaLevel)
			.. " A=" .. tostring(self.AttackLevel)
			.. " Souls=" .. tostring(self.TotalSouls))

		if upgradeType == "Health" then
			self:IncreaseHealth()
			log("PlayerSoulSystem HandleUpgradeRequestEvent: applied Health -> H=" .. tostring(self.HealthLevel))
			return
		end

		if upgradeType == "Stamina" then
			self:IncreaseStamina()
			log("PlayerSoulSystem HandleUpgradeRequestEvent: applied Stamina -> S=" .. tostring(self.StaminaLevel) .. " CurrentStamina=" .. tostring(self.CurrentStamina) .. " MaxStamina=" .. tostring(self:GetMaxStamina()))
			return
		end

		if upgradeType == "Attack Power" then
			self:IncreaseAttack()
			log("PlayerSoulSystem HandleUpgradeRequestEvent: applied Attack Power -> A=" .. tostring(self.AttackLevel))
			return
		end

		log("PlayerSoulSystem HandleUpgradeRequestEvent: unknown upgradeType=" .. tostring(upgradeType))
	end

	method void SetInputLocked(boolean locked)
		if self.InputLocked == locked then
			return
		end

		self.InputLocked = locked

		local rigidbody = self.Entity.RigidbodyComponent
		if isvalid(rigidbody) == false then
			return
		end

		if locked then
			if self.CachedWalkSpeed < 0 then
				self.CachedWalkSpeed = rigidbody.WalkSpeed
			end
			if self.CachedWalkJump < 0 then
				self.CachedWalkJump = rigidbody.WalkJump
			end
			rigidbody.WalkSpeed = 0
			rigidbody.WalkJump = 0
			rigidbody.MoveVelocity = Vector2.zero
			return
		end

		if self.CachedWalkSpeed >= 0 then
			rigidbody.WalkSpeed = self.CachedWalkSpeed
		end
		if self.CachedWalkJump >= 0 then
			rigidbody.WalkJump = self.CachedWalkJump
		end
		self.CachedWalkSpeed = -1
		self.CachedWalkJump = -1
	end

	method boolean IsInputLocked()
		return self.InputLocked
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyDownEvent(KeyDownEvent event)
		-- debug key removed to avoid spam
	end

end
