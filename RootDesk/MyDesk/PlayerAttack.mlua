@Component
script PlayerAttack extends AttackComponent

	@HideFromInspector
	property any Shape = nil

	@MinValue(1)
	property integer BaseDamage = 50

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.Shape = BoxShape(Vector2.zero, Vector2.one, 0)
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		if defender == nil or defender == self.Entity then
			return false
		end

		local playerHit = defender:GetComponent("PlayerHit")
		if isvalid(playerHit) then
			if playerHit:IsImmune() then
				return false
			end

			playerHit:CanBeHit()
			return true
		end

		if isvalid(defender:GetComponent("HitComponent")) then
			return true
		end

		return __base:IsAttackTarget(defender, attackInfo)
	end

	@ExecSpace("ServerOnly")
	method void AttackNormal()
		local playerController = self.Entity.PlayerControllerComponent
		local transform = self.Entity.TransformComponent
		if playerController and transform then
			local worldPosition = transform.WorldPosition
			local attackOffset = Vector2(worldPosition.x + 0.5 * playerController.LookDirectionX, worldPosition.y + 0.5)
			self.Shape.Position = attackOffset
			
			self:AttackFast(self.Shape, nil, CollisionGroups.Monster)
		end
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		local soulSystem = self.Entity:GetComponent("PlayerSoulSystem")
		if isvalid(soulSystem) == false then
			return self.BaseDamage
		end

		local damage = math.floor(self.BaseDamage * soulSystem:GetAttackMultiplier())
		if damage < 1 then
			damage = 1
		end
		return damage
	end

	method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
		return _UtilLogic:RandomDouble() < 0.3
	end

	method float GetCriticalDamageRate()
		return 2
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandlePlayerActionEvent(PlayerActionEvent event)
		-- Parameters
		local ActionName = event.ActionName
		-- local PlayerEntity = event.PlayerEntity
		--------------------------------------------------------

		local soulSystem = self.Entity:GetComponent("PlayerSoulSystem")
		if isvalid(soulSystem) and soulSystem:IsInputLocked() then
			return
		end
		
		if ActionName == "Attack" then
			self:AttackNormal()
		end
	end

end