@Component
script ShieldThrow extends Component

	@MinValue(0)
	property number Cooldown = 2.5

	@MinValue(0)
	property number Speed = 12

	@HideFromInspector
	property number LastUseTime = 0

	@HideFromInspector
	property Entity ActiveProjectile = nil

	property number SpawnDelay = 0.0

	property Vector3 SpawnOffset = Vector3(0.8, 0.6, 0)

	@HideFromInspector
	property number SpawnTimerId = 0

	@MinValue(0)
	property number BoomerangRange = 6.0

	@MinValue(0)
	property number BoomerangDistanceTravelled = 0

	@HideFromInspector
	property boolean IsReturning = false

	@HideFromInspector
	property number ReturnThreshold = 0.5

	@MinValue(0)
	property number MinOutDistance = 10.0

	@HideFromInspector
	property string PreviousShieldEquip = ""

	@HideFromInspector
	property number BoomerangTimerId = 0

	@HideFromInspector
	property number BoomerangStartTime = 0

	@HideFromInspector
	property Vector3 BoomerangDirection = Vector3(0, 0, 0)

	@HideFromInspector
	property Vector3 BoomerangSourcePosition = Vector3(0, 0, 0)

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		local playerController = self.Entity.PlayerControllerComponent
		if isvalid(playerController) then
			playerController:SetActionKey(KeyboardKey.Q, "ShieldThrow")
		end
	end

	method boolean CanUse()
		if isvalid(self.ActiveProjectile) then
			return false
		end
		if self.SpawnTimerId ~= 0 then
			return false
		end

		local currentTime = _UtilLogic.ElapsedSeconds
		return currentTime - self.LastUseTime >= self.Cooldown
	end

	method void HideShield()
		local costumeManager = self.Entity:GetComponent("CostumeManagerComponent")
		if isvalid(costumeManager) == false then
			return
		end

		local shieldRUID = costumeManager:GetEquip(MapleAvatarItemCategory.OneHandedWeapon)
		if shieldRUID ~= nil and shieldRUID ~= "" then
			self.PreviousShieldEquip = shieldRUID
			costumeManager:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, "")
		end
	end

	method void RestoreShield()
		if self.PreviousShieldEquip == "" then
			return
		end

		local costumeManager = self.Entity:GetComponent("CostumeManagerComponent")
		if isvalid(costumeManager) == false then
			return
		end

		costumeManager:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, self.PreviousShieldEquip)
		self.PreviousShieldEquip = ""
	end

	method void TryThrow()
		if self:CanUse() == false then
			return
		end

		self.LastUseTime = _UtilLogic.ElapsedSeconds
		self.Entity.StateComponent:ChangeState("THROW")
		log("ShieldThrow triggered")

		local transform = self.Entity.TransformComponent
		if isvalid(transform) == false then
			return
		end

		local spawnDirection = Vector3(self.Entity.PlayerControllerComponent.LookDirectionX, 0, 0)
		local startPosition = transform.WorldPosition + Vector3(self.Entity.PlayerControllerComponent.LookDirectionX * self.SpawnOffset.x, self.SpawnOffset.y, self.SpawnOffset.z)

		if self.SpawnTimerId ~= 0 then
			_TimerService:ClearTimer(self.SpawnTimerId)
			self.SpawnTimerId = 0
		end

		if self.SpawnDelay > 0 then
			self.SpawnTimerId = _TimerService:SetTimerOnce(function()
				self:SpawnProjectile(startPosition, spawnDirection)
				self.SpawnTimerId = 0
			end, self.SpawnDelay)
		else
			self:SpawnProjectile(startPosition, spawnDirection)
		end
	end

	method void SpawnProjectile(Vector3 startPosition, Vector3 spawnDirection)
		self:HideShield()

		local modelId = _EntryService:GetModelIdByName("Model_Projectile")

local ownerId = nil
	local playerComponent = self.Entity:GetComponent("PlayerComponent")
	if isvalid(playerComponent) then
		ownerId = playerComponent.UserId
	end

	local projectile = _SpawnService:SpawnByModelId(modelId, "ShieldProjectile", startPosition, self.Entity.Parent, ownerId)
		if isvalid(projectile) == false then
			return
		end

		self.ActiveProjectile = projectile
		projectile.Enable = true
		projectile.TransformComponent.WorldPosition = startPosition
		projectile.TransformComponent.Scale = Vector3(0.8, 0.8, 1)

		self.BoomerangSourcePosition = startPosition
		self.BoomerangDirection = spawnDirection
		self.BoomerangDistanceTravelled = 0
		self.IsReturning = false

		if self.BoomerangTimerId ~= 0 then
			_TimerService:ClearTimer(self.BoomerangTimerId)
		end

		local timerId = _TimerService:SetTimerRepeat(function()
			if isvalid(self.ActiveProjectile) == false or isvalid(self.Entity) == false then
				self:RestoreShield()
				if self.BoomerangTimerId ~= 0 then
					_TimerService:ClearTimer(self.BoomerangTimerId)
					self.BoomerangTimerId = 0
				end
				return
			end

			local projectile = self.ActiveProjectile
			local currentPos = projectile.TransformComponent.WorldPosition
			local deltaTime = 1.0 / 60.0
			local moveDistance = self.Speed * deltaTime

			if self.IsReturning then
				local playerPos = self.Entity.TransformComponent.WorldPosition + Vector3(0, self.SpawnOffset.y, 0)
				local toPlayer = playerPos - currentPos
				local distanceToPlayer = math.sqrt(toPlayer.x * toPlayer.x + toPlayer.y * toPlayer.y + toPlayer.z * toPlayer.z)
				if distanceToPlayer <= 0.35 then
					projectile.TransformComponent.WorldPosition = playerPos
					projectile.Enable = false
					self.ActiveProjectile = nil
					_TimerService:ClearTimer(self.BoomerangTimerId)
					self.BoomerangTimerId = 0
					self:RestoreShield()
					return
				end

				local dir = Vector3(toPlayer.x / distanceToPlayer, toPlayer.y / distanceToPlayer, toPlayer.z / distanceToPlayer)
				projectile.TransformComponent.WorldPosition = currentPos + dir * moveDistance
			else
				local nextPos = currentPos + self.BoomerangDirection * moveDistance
				self.BoomerangDistanceTravelled = self.BoomerangDistanceTravelled + moveDistance
				projectile.TransformComponent.WorldPosition = nextPos

				local playerX = self.Entity.TransformComponent.WorldPosition.x
				local alignment = math.abs(nextPos.x - playerX)
				if self.BoomerangDistanceTravelled >= self.MinOutDistance and alignment <= self.ReturnThreshold then
					self.IsReturning = true
				elseif self.BoomerangDistanceTravelled >= self.BoomerangRange then
					self.IsReturning = true
				end
			end
		end, 1.0 / 60.0)

		self.BoomerangTimerId = timerId
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandlePlayerActionEvent(PlayerActionEvent event)
		if event.ActionName == "ShieldThrow" then
			self:TryThrow()
		end
	end

end
