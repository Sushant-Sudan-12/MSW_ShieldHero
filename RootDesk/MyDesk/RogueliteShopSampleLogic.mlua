@Logic
script RogueliteShopSampleLogic extends Logic

	property Entity Root = nil

	property Entity Popup = nil

	property InteractionComponent ShopInteraction = nil

	property string ShopModelName = "Model_RogueliteShop"

	property string ShopEntityName = "RogueliteShop"

	property boolean StartingAreaOnly = true

	@HideFromInspector
	property boolean InteractionBound = false

	@HideFromInspector
	property boolean BindingFailureLogged = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		log("RogueliteShopSampleLogic: OnBeginPlay")
		self.Root = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		if isvalid(self.Root) == false then
			log_error("RogueliteShopSampleLogic: /ui/DefaultGroup not found")
			return
		end

		self:SpawnShop()
		self:BindShopInteraction()
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if self.InteractionBound == false then
			self:BindShopInteraction()
		end
	end

	@ExecSpace("ClientOnly")
	method void SpawnShop()
		local modelId = _EntryService:GetModelIdByName(self.ShopModelName)
		log("RogueliteShopSampleLogic: spawning model=" .. tostring(self.ShopModelName) .. " modelId=" .. tostring(modelId))
		if modelId == nil or modelId == "" then
			log_error("RogueliteShopSampleLogic: model not found: " .. tostring(self.ShopModelName))
			return
		end

		self.Popup = _SpawnService:SpawnByModelId(modelId, self.ShopEntityName, Vector3.zero, self.Root)
		if isvalid(self.Popup) == false then
			log_error("RogueliteShopSampleLogic: failed to spawn " .. tostring(self.ShopModelName))
			return
		end

		self.Popup:SetEnable(false)
		log("RogueliteShopSampleLogic: popup spawned and disabled")
	end

	@ExecSpace("ClientOnly")
	method void BindShopInteraction()
		if self.InteractionBound then
			return
		end

		local shopEntity = _EntityService:GetEntityByPath("/maps/StartingArea/Model_Shop")
		log("RogueliteShopSampleLogic: shop lookup=" .. tostring(shopEntity))
		if isvalid(shopEntity) then
			self.ShopInteraction = shopEntity.InteractionComponent
		end

		if isvalid(self.ShopInteraction) then
			self.ShopInteraction.Entity:ConnectEvent(InteractionEvent, function(event) self:HandleShopInteraction(event) end)
			self.InteractionBound = true
			self.BindingFailureLogged = false
			log("RogueliteShopSampleLogic: interaction listener ready")
		elseif self.BindingFailureLogged == false then
			log_error("RogueliteShopSampleLogic: Model_Shop or InteractionComponent not found")
			self.BindingFailureLogged = true
		end
	end

	@ExecSpace("ClientOnly")
	method void HandleShopInteraction(InteractionEvent event)
		log("RogueliteShopSampleLogic: interaction received")
		if self.StartingAreaOnly then
			local player = _UserService.LocalPlayer
			if isvalid(player) == false or string.find(tostring(player.Path), "StartingArea", 1, true) == nil then
				log_error("RogueliteShopSampleLogic: interaction rejected because player is not in StartingArea")
				return
			end
		end

		if isvalid(self.Popup) == false then
			self:SpawnShop()
		end

		if isvalid(self.Popup) then
			self.Popup:SetEnable(true)
			local shopUI = self.Popup:GetComponent("RogueliteUpgradeShopUI")
			if isvalid(shopUI) then
				log("RogueliteShopSampleLogic: opening shop UI")
				shopUI:Open()
			else
				log_error("RogueliteShopSampleLogic: RogueliteUpgradeShopUI missing from spawned model")
			end
		end
	end

end
