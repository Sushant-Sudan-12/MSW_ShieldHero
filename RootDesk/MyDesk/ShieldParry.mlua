@Component
script ShieldParry extends Component

	@Sync
	property boolean IsParrying = false

	@Sync
	property boolean WantsParry = false

	@Sync
	property number LastParryInputTime = 0

	@MinValue(0)
	property number ParryBackRange = 0.6

	@MinValue(0)
	property number ParryFrontRange = 1.0

	@MinValue(0)
	property number ParryHeight = 1.8

	property number ParryHeightOffset = 0.4

	@MinValue(0)
	property number DebugScanLogInterval = 0.35

	@MinValue(0)
	property number ServerHeartbeatLogInterval = 1.5

	@MinValue(0)
	property number ParryHoldGraceSeconds = 1.2

	@MinValue(0)
	property number MinParryActiveSeconds = 0.45

	@MinValue(0)
	property number HoldActionSendInterval = 0.12

	@HideFromInspector
	property any DisabledParryAttackers = nil

	@HideFromInspector
	property number LastDebugScanLogTime = 0

	@HideFromInspector
	property number LastServerHeartbeatLogTime = 0

	@HideFromInspector
	property number ParryStartedAt = 0

	@HideFromInspector
	property number LastHoldActionSendTime = 0
	    @HideFromInspector
    property Entity ActiveParryModel = nil

    @HideFromInspector
    property number ParryModelTimerId = 0

    @MinValue(0)
    property number ParrySpawnOffsetX = 0.8

    @MinValue(0)
    property number ParrySpawnOffsetY = 0.6

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		local playerController = self.Entity.PlayerControllerComponent
		if isvalid(playerController) then
			playerController:SetActionKey(KeyboardKey.E, "ShieldParryStart")
			log("ShieldParry client setup: E mapped to ShieldParryStart")
		end
	end


	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		self:LogServerHeartbeat()
		self:SyncParryIntent()
		self:LogActiveParryRange()
		self:ScanMonstersInParryRange()
		self:RefreshDisabledMonsterAttacks()
	end

	@ExecSpace("ServerOnly")
	method void LogServerHeartbeat()
		local now = _UtilLogic.ElapsedSeconds
		if now - self.LastServerHeartbeatLogTime < self.ServerHeartbeatLogInterval then
			return
		end

		self.LastServerHeartbeatLogTime = now
		local sinceInput = -1
		if self.LastParryInputTime > 0 then
			sinceInput = now - self.LastParryInputTime
		end
		log("ShieldParry server heartbeat: wantsParry=" .. tostring(self.WantsParry)
			.. " isParrying=" .. tostring(self.IsParrying)
			.. " lastInput=" .. tostring(self.LastParryInputTime)
			.. " sinceInput=" .. tostring(sinceInput))
	end

	@ExecSpace("ServerOnly")
	method void SyncParryIntent()
		local now = _UtilLogic.ElapsedSeconds
		local inputRecentlyHeld = false
		if self.LastParryInputTime > 0 and now - self.LastParryInputTime <= self.ParryHoldGraceSeconds then
			inputRecentlyHeld = true
		end

		if self.WantsParry ~= inputRecentlyHeld then
			self.WantsParry = inputRecentlyHeld
		end

		if inputRecentlyHeld and self.IsParrying == false then
			log("ShieldParry sync: client requested parry start")
			self:TryParry()
			return
		end

		if inputRecentlyHeld == false and self.IsParrying then
			if self.ParryStartedAt > 0 and now - self.ParryStartedAt < self.MinParryActiveSeconds then
				return
			end
			log("ShieldParry sync: client requested parry end")
			self:EndParry()
		end
	end

	@ExecSpace("ServerOnly")
	method void EnsureParryActiveFromIntent(string source)
		if self.WantsParry and self.IsParrying == false then
			log("ShieldParry intent promotion: source=" .. tostring(source)
				.. " wantsParry=true while isParrying=false")
			self:TryParry()
		end
	end

	@ExecSpace("ServerOnly")
	method void TryParry()
		if self.IsParrying then
			log("ShieldParry TryParry ignored: already parrying")
			return
		end

		self.IsParrying = true
		self:SpawnParryModel()
		self.ParryStartedAt = _UtilLogic.ElapsedSeconds
		local playerController = self.Entity.PlayerControllerComponent
		local lookDirectionX = 0
		if isvalid(playerController) then
			lookDirectionX = playerController.LookDirectionX
		end
		log("Started parrying")
		log("ShieldParry start: searching active range lookDirectionX=" .. tostring(lookDirectionX)
			.. " backRange=" .. tostring(self.ParryBackRange)
			.. " frontRange=" .. tostring(self.ParryFrontRange)
			.. " height=" .. tostring(self.ParryHeight))

		local stateComponent = self.Entity.StateComponent
		if isvalid(stateComponent) then
			stateComponent:ChangeState("PARRY")
		end
	end

	@ExecSpace("ServerOnly")
	method void EndParry()
		if self.IsParrying == false then
			log("ShieldParry EndParry ignored: not parrying")
			return
		end

		self.IsParrying = false
		self.ParryStartedAt = 0
		self:RestoreAllDisabledMonsterAttacks("ParryEnded")
		log("Parry ended")
		log("ShieldParry closed: restored all tracked monster attacks")

		local stateComponent = self.Entity.StateComponent
		if isvalid(stateComponent) then
			stateComponent:ChangeState("IDLE")
		end
	end

	@ExecSpace("ServerOnly")
    method void SpawnParryModel()
        local modelId = _EntryService:GetModelIdByName("Model_Parry")
        if modelId == nil or modelId == "" then
            log("ShieldParry SpawnParryModel: Model_Parry not found")
            return
        end

        local playerController = self.Entity.PlayerControllerComponent
        local lookDirectionX = 1
        if isvalid(playerController) then
            lookDirectionX = playerController.LookDirectionX
            if lookDirectionX == 0 then
                lookDirectionX = 1
            end
        end

        local transform = self.Entity.TransformComponent
        if isvalid(transform) == false then
            log("ShieldParry SpawnParryModel: TransformComponent missing")
            return
        end

        local spawnPosition = transform.WorldPosition + Vector3(lookDirectionX * self.ParrySpawnOffsetX, self.ParrySpawnOffsetY, 0)

        if isvalid(self.ActiveParryModel) then
            self.ActiveParryModel:Destroy()
            self.ActiveParryModel = nil
        end

        local parryModel = _SpawnService:SpawnByModelId(modelId, "Model_Parry", spawnPosition, self.Entity.Parent)
        if isvalid(parryModel) == false then
            log("ShieldParry SpawnParryModel: spawn failed")
            return
        end

        self.ActiveParryModel = parryModel
        parryModel.Enable = true
        parryModel.TransformComponent.WorldPosition = spawnPosition

        if self.ParryModelTimerId ~= 0 then
            _TimerService:ClearTimer(self.ParryModelTimerId)
            self.ParryModelTimerId = 0
        end

        self.ParryModelTimerId = _TimerService:SetTimerOnce(function()
            if isvalid(self.ActiveParryModel) then
                self.ActiveParryModel:Destroy()
                self.ActiveParryModel = nil
            end
            self.ParryModelTimerId = 0
        end, self.ParryDuration)
    end

	method void SendParryAction(string actionName)
		local evt = PlayerActionEvent(actionName)
		self.Entity:SendEvent(evt)
	end

	method void EnsureDisabledParryAttackersTable()
		if self.DisabledParryAttackers == nil then
			self.DisabledParryAttackers = {}
		end
	end

	@ExecSpace("ServerOnly")
	method void ScanMonstersInParryRange()
		if self.IsParrying == false then
			return
		end

		local parent = self.Entity.Parent
		if isvalid(parent) == false or parent.Children == nil then
			return
		end

		for _, child in ipairs(parent.Children) do
			if isvalid(child) and child ~= self.Entity then
				local monsterAttack = child:GetComponent("MonsterAttack")
				if isvalid(monsterAttack) then
					self:DisableMonsterAttackDueToParry(child, "ShieldParry.ScanMonstersInParryRange")
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void LogActiveParryRange()
		if self.IsParrying == false then
			return
		end

		local now = _UtilLogic.ElapsedSeconds
		if now - self.LastDebugScanLogTime < self.DebugScanLogInterval then
			return
		end

		local playerController = self.Entity.PlayerControllerComponent
		local playerTransform = self.Entity.TransformComponent
		if isvalid(playerController) == false or isvalid(playerTransform) == false then
			return
		end

		self.LastDebugScanLogTime = now
		log("ShieldParry active range scan: playerX=" .. tostring(playerTransform.WorldPosition.x)
			.. " playerY=" .. tostring(playerTransform.WorldPosition.y)
			.. " lookDirectionX=" .. tostring(playerController.LookDirectionX)
			.. " backRange=" .. tostring(self.ParryBackRange)
			.. " frontRange=" .. tostring(self.ParryFrontRange)
			.. " height=" .. tostring(self.ParryHeight))
	end

	method boolean IsEntityInParrySideRange(Entity attacker)
		if (self.IsParrying == false and self.WantsParry == false) or isvalid(attacker) == false then
			return false
		end

		local playerController = self.Entity.PlayerControllerComponent
		local playerTransform = self.Entity.TransformComponent
		local attackerTransform = attacker.TransformComponent
		if isvalid(playerController) == false or isvalid(playerTransform) == false or isvalid(attackerTransform) == false then
			return false
		end

		local lookDirectionX = playerController.LookDirectionX
		if lookDirectionX == 0 then
			return false
		end

		local playerPos = playerTransform.WorldPosition
		local attackerPos = attackerTransform.WorldPosition
		local forwardDistance = (attackerPos.x - playerPos.x) * lookDirectionX
		if forwardDistance < -self.ParryBackRange or forwardDistance > self.ParryFrontRange then
			return false
		end

		local centerY = playerPos.y + self.ParryHeightOffset
		return math.abs(attackerPos.y - centerY) <= (self.ParryHeight * 0.5)
	end

	@ExecSpace("ServerOnly")
	method boolean DisableMonsterAttackDueToParry(Entity attacker, string source)
		self:EnsureParryActiveFromIntent(source)

		if self:IsEntityInParrySideRange(attacker) == false then
			log("ShieldParry disable miss: enemy=" .. tostring(attacker)
				.. " source=" .. tostring(source)
				.. " isParrying=" .. tostring(self.IsParrying)
				.. " wantsParry=" .. tostring(self.WantsParry))
			return false
		end

		local monsterAttack = attacker:GetComponent("MonsterAttack")
		if isvalid(monsterAttack) == false then
			return false
		end

		if monsterAttack.Enable == false then
			return true
		end

		monsterAttack.Enable = false
		self:EnsureDisabledParryAttackersTable()
		table.insert(self.DisabledParryAttackers, attacker)
		log("ShieldParry attacker found: enemy=" .. tostring(attacker)
			.. " source=" .. tostring(source))
		log("ShieldParry enemy entered parry direction: enemy=" .. tostring(attacker)
			.. " source=" .. tostring(source)
			.. " enemy attack component disabled")
		return true
	end

	@ExecSpace("ServerOnly")
	method void RestoreMonsterAttack(Entity attacker, string source)
		if isvalid(attacker) == false then
			return
		end

		local monsterAttack = attacker:GetComponent("MonsterAttack")
		if isvalid(monsterAttack) then
			monsterAttack.Enable = true
			log("ShieldParry enemy left parry range: enemy=" .. tostring(attacker)
				.. " source=" .. tostring(source)
				.. " enemy attack component re-enabled")
		end
	end

	@ExecSpace("ServerOnly")
	method void RefreshDisabledMonsterAttacks()
		self:EnsureDisabledParryAttackersTable()
		for index = #self.DisabledParryAttackers, 1, -1 do
			local attacker = self.DisabledParryAttackers[index]
			if isvalid(attacker) == false then
				table.remove(self.DisabledParryAttackers, index)
			elseif self:IsEntityInParrySideRange(attacker) == false then
				self:RestoreMonsterAttack(attacker, "RefreshDisabledMonsterAttacks")
				table.remove(self.DisabledParryAttackers, index)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void RestoreAllDisabledMonsterAttacks(string source)
		self:EnsureDisabledParryAttackersTable()
		for index = #self.DisabledParryAttackers, 1, -1 do
			self:RestoreMonsterAttack(self.DisabledParryAttackers[index], source)
			table.remove(self.DisabledParryAttackers, index)
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyDownEvent(KeyDownEvent event)
		if event.key == KeyboardKey.E then
			self.LastParryInputTime = _UtilLogic.ElapsedSeconds
			self.WantsParry = true
			log("ShieldParry input: E down -> request start parry")
			self:SendParryAction("ShieldParryStart")
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyHoldEvent(KeyHoldEvent event)
		if event.key == KeyboardKey.E then
			local now = _UtilLogic.ElapsedSeconds
			self.LastParryInputTime = _UtilLogic.ElapsedSeconds
			self.WantsParry = true
			if now - self.LastHoldActionSendTime >= self.HoldActionSendInterval then
				self.LastHoldActionSendTime = now
				self:SendParryAction("ShieldParryHold")
			end
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyUpEvent(KeyUpEvent event)
		if event.key == KeyboardKey.E then
			self.LastParryInputTime = 0
			self.WantsParry = false
			log("ShieldParry input: E up -> request end parry")
			self:SendParryAction("ShieldParryEnd")
		end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandlePlayerActionEvent(PlayerActionEvent event)
		log("ShieldParry action event received: action=" .. tostring(event.ActionName)
			.. " isParrying=" .. tostring(self.IsParrying))
		if event.ActionName == "ShieldParryStart" then
			self.LastParryInputTime = _UtilLogic.ElapsedSeconds
			self.WantsParry = true
			self:TryParry()
			return
		end

		if event.ActionName == "ShieldParryHold" then
			self.LastParryInputTime = _UtilLogic.ElapsedSeconds
			self.WantsParry = true
			if self.IsParrying == false then
				self:TryParry()
			end
			return
		end

		if event.ActionName == "ShieldParryEnd" then
			self.LastParryInputTime = 0
			self.WantsParry = false
			self:EndParry()
		end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "InputService")
	handler HandleServerKeyDownEvent(KeyDownEvent event)
		if event.key ~= KeyboardKey.E then
			return
		end

		self.WantsParry = true
		log("ShieldParry server fallback input: E down")
		self:TryParry()
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "InputService")
	handler HandleServerKeyUpEvent(KeyUpEvent event)
		if event.key ~= KeyboardKey.E then
			return
		end

		self.WantsParry = false
		log("ShieldParry server fallback input: E up")
		self:EndParry()
	end

end
