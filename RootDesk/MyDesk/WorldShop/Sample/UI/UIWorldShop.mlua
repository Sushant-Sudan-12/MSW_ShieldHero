@Component
script UIWorldShop extends Component

	property Entity ItemPanel = nil

	property GridViewComponent GridView = nil

	property integer Category = 0

	@MinValue(1)
	property integer ShopOrderInLayer = 10000

	property string ShopSortingLayer = "UI"

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		log("Environment.WorldId = " .. tostring(Environment.WorldId))
		local entity = self.Entity
		
		local panel = entity:GetChildByName("Panel")
		
		local title = panel:GetChildByName("Title")
		local btnExit = title:GetChildByName("Btn_Exit")
		btnExit:ConnectEvent(ButtonClickEvent, function()
			self:Close()
		end)
		
		local main = panel:GetChildByName("Main")
		self.ItemPanel = main:GetChildByName("ItemPanel")
		self:ApplyTopSorting()
	end

	@ExecSpace("ClientOnly")
	method void ApplyTopSorting()
		local spriteRenderers = self.Entity:GetChildComponentsByTypeName("SpriteGUIRendererComponent", true)
		for _, component in ipairs(spriteRenderers) do
			---@type SpriteGUIRendererComponent
			local renderer = component
			renderer.OverrideSorting = true
			renderer.SortingLayer = self.ShopSortingLayer
			renderer.OrderInLayer = self.ShopOrderInLayer
		end

		local textRenderers = self.Entity:GetChildComponentsByTypeName("TextGUIRendererComponent", true)
		for _, component in ipairs(textRenderers) do
			---@type TextGUIRendererComponent
			local renderer = component
			renderer.OverrideSorting = true
			renderer.SortingLayer = self.ShopSortingLayer
			renderer.OrderInLayer = self.ShopOrderInLayer
		end

		local inputRenderers = self.Entity:GetChildComponentsByTypeName("TextGUIRendererInputComponent", true)
		for _, component in ipairs(inputRenderers) do
			---@type TextGUIRendererInputComponent
			local renderer = component
			renderer.OverrideSorting = true
			renderer.SortingLayer = self.ShopSortingLayer
			renderer.OrderInLayer = self.ShopOrderInLayer
		end
	end

	@ExecSpace("ClientOnly")
	method void Close()
		self.ItemPanel.UIWorldShopItemPanel:Close()
		self.Entity:SetEnable(false)
	end

	@ExecSpace("ClientOnly")
	method void Open()
		self.Category = _WorldShopCategoryType.Item
		self:ApplyPanel(self.Category)
		
		self.Entity:SetEnable(true)
	end

	@ExecSpace("ClientOnly")
	method void Refresh(WorldShopPurchaseResultEvent evt)
		local isItemPanel = self:IsItemPanelCategory(self.Category)
		if isItemPanel then
			self.ItemPanel.UIWorldShopItemPanel:Refresh(evt)
		elseif self.Category == _WorldShopCategoryType.Pass then
			self.PassPanel.UIWorldShopPassPanel:Refresh(evt)
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyPanel(integer category)
		self.Category = _WorldShopCategoryType.Item
		self.ItemPanel.UIWorldShopItemPanel:Apply(self.Category)
		self.ItemPanel:SetEnable(true)
	end

	@ExecSpace("ClientOnly")
	method boolean IsItemPanelCategory(integer category)
		return true
	end

	@ExecSpace("ClientOnly")
	@EventSender("LocalPlayer")
	handler HandleWorldShopPurchaseResultEvent(WorldShopPurchaseResultEvent event)
		-- Parameters
		-- local Reason = event.Reason
		-- local ProductId = event.ProductId
		---------------------------------------------------------
		if not self.Entity.EnabledInHierarchy then
			return
		end
		
		self:Refresh(event)
	end

end