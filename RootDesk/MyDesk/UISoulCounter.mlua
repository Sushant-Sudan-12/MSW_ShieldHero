@ExecSpace("Client")
@Component
script UISoulCounter extends Component

	property Entity TextTarget = nil

	property string Prefix = "x"

	property number LastShownSouls = 0

	method void OnBeginPlay()
		log("UISoulCounter OnBeginPlay target=" .. tostring(self.TextTarget))
		self:ForceSetInitialValue()
		self:Refresh()
	end

	method void OnUpdate(number delta)
		self:Refresh()
	end

	method void ForceSetInitialValue()
		self.LastShownSouls = -1
		self:WriteText(self.Prefix .. "0")
	end

	method void Refresh()
		local player = _UserService.LocalPlayer
		if isvalid(player) == false then
			log("UISoulCounter Refresh: no valid local player")
			return
		end

		local soulSystem = player:GetComponent("PlayerSoulSystem")
		if isvalid(soulSystem) == false then
			log("UISoulCounter Refresh: no PlayerSoulSystem on player")
			return
		end

		if soulSystem.TotalSouls == self.LastShownSouls then
			return
		end

		local textValue = self.Prefix .. tostring(soulSystem.TotalSouls)
		self.LastShownSouls = soulSystem.TotalSouls
		log("UISoulCounter Refresh: totalSouls changed, updating text to " .. textValue)
		self:WriteText(textValue)
	end

	method void WriteText(string value)
		local target = self.TextTarget
		if isvalid(target) == false then
			target = self.Entity
		end

		if isvalid(target.TextComponent) then
			target.TextComponent.Text = value
			log("UISoulCounter WriteText: wrote text via TextComponent -> " .. value)
			return
		end

		if isvalid(target.TextGUIRendererComponent) then
			target.TextGUIRendererComponent.Text = value
			log("UISoulCounter WriteText: wrote text via TextGUIRendererComponent -> " .. value)
			return
		end

		if isvalid(target.TextInputComponent) then
			target.TextInputComponent.Text = value
			log("UISoulCounter WriteText: wrote text via TextInputComponent -> " .. value)
			return
		end

		log("UISoulCounter WriteText: no valid text target found")
	end

end
