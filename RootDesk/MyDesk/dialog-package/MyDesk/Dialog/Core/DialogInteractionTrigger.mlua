@Component
script DialogInteractionTrigger extends Component

	@Sync
	property string DialogId = "Tutorial"

	@ExecSpace("ClientOnly")
	method void StartDialog()
		if self.DialogId == nil or self.DialogId == "" then
			return
		end

		_DialogLogic:StartDialog(self.DialogId)
	end

	@ExecSpace("ClientOnly")
	@EventSender("Self")
	handler HandleInteractionEvent(InteractionEvent event)
		self:StartDialog()
	end

end
