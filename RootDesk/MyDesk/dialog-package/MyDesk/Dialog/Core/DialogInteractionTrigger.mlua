@Component
script DialogInteractionTrigger extends Component

	@Sync
	property string DialogId = "Tutorial"

	@Sync
	property boolean TriggerOnInteractionEvent = true

	@Sync
	property boolean TriggerOnInteractionEnter = false

	@ExecSpace("ClientOnly")
	method void StartDialog()
		if self.DialogId == nil or self.DialogId == "" then
			return
		end

		_DialogLogic:StartDialog(self.DialogId)
	end

	@ExecSpace("ClientOnly")
	@EventSender("Self")
	handler HandleInteractionEvent(InteractionEvent event)
		if self.TriggerOnInteractionEvent then
			self:StartDialog()
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Self")
	handler HandleInteractionEnterEvent(InteractionEnterEvent event)
		if self.TriggerOnInteractionEnter then
			self:StartDialog()
		end
	end

end
