@ExecSpace("ClientOnly")
@Component
script PlayerStatTextDisplay extends Component

    property Entity healthTextTarget = nil
    property Entity staminaTextTarget = nil

    property Entity healthLevelTextTarget = nil
    property Entity staminaLevelTextTarget = nil
    property Entity attackLevelTextTarget = nil

    @HideFromInspector
    property string LastLoggedHealthText = ""

    @HideFromInspector
    property string LastLoggedStaminaText = ""

    @HideFromInspector
    property string LastLoggedHealthLevel = ""

    @HideFromInspector
    property string LastLoggedStaminaLevel = ""

    @HideFromInspector
    property string LastLoggedAttackLevel = ""

    method Entity ResolveEntityByPaths(string p1, string p2, string p3)
        local e = nil

        if p1 ~= nil and p1 ~= "" then
            e = _EntityService:GetEntityByPath(p1)
            if isvalid(e) then
                return e
            end
        end

        if p2 ~= nil and p2 ~= "" then
            e = _EntityService:GetEntityByPath(p2)
            if isvalid(e) then
                return e
            end
        end

        if p3 ~= nil and p3 ~= "" then
            e = _EntityService:GetEntityByPath(p3)
            if isvalid(e) then
                return e
            end
        end

        return nil
    end

    method boolean IsEntityOnPath(Entity e, string requiredPathPrefix)
        if isvalid(e) == false then
            return false
        end

        if requiredPathPrefix == nil or requiredPathPrefix == "" then
            return true
        end

        if e.Path == nil or e.Path == "" then
            return false
        end

        local startIndex, _ = string.find(e.Path, requiredPathPrefix, 1, true)
        return startIndex ~= nil
    end

    method void EnsureDefaultTextTargets()
        if self:IsEntityOnPath(self.healthTextTarget, "/ui/PlayerStats/UIMyInfo/HP_bar") == false then
            self.healthTextTarget = self:ResolveEntityByPaths(
                "/ui/PlayerStats/UIMyInfo/HP_bar/HP",
                "/ui/PlayerStats/UIMyInfo/HP_bar",
                nil
            )
        end

        if self:IsEntityOnPath(self.staminaTextTarget, "/ui/PlayerStats/UIMyInfo/Stamina_Bar") == false then
            self.staminaTextTarget = self:ResolveEntityByPaths(
                "/ui/PlayerStats/UIMyInfo/Stamina_Bar/Stamina",
                "/ui/PlayerStats/UIMyInfo/Stamina_Bar",
                nil
            )
        end

        if self:IsEntityOnPath(self.healthLevelTextTarget, "/ui/PlayerStats/SkillQuickSlot/slot_01") == false then
            self.healthLevelTextTarget = self:ResolveEntityByPaths(
                "/ui/PlayerStats/SkillQuickSlot/slot_01/UIText_2",
                "/ui/PlayerStats/SkillQuickSlot/slot_01/UIText",
                "/ui/PlayerStats/SkillQuickSlot/slot_01"
            )
        end

        if self:IsEntityOnPath(self.staminaLevelTextTarget, "/ui/PlayerStats/SkillQuickSlot/slot_3") == false then
            self.staminaLevelTextTarget = self:ResolveEntityByPaths(
                "/ui/PlayerStats/SkillQuickSlot/slot_3/UIText_2",
                "/ui/PlayerStats/SkillQuickSlot/slot_3/UIText",
                "/ui/PlayerStats/SkillQuickSlot/slot_3"
            )
        end

        if self:IsEntityOnPath(self.attackLevelTextTarget, "/ui/PlayerStats/SkillQuickSlot/slot_2") == false then
            self.attackLevelTextTarget = self:ResolveEntityByPaths(
                "/ui/PlayerStats/SkillQuickSlot/slot_2/UIText_1",
                "/ui/PlayerStats/SkillQuickSlot/slot_2/UIText",
                "/ui/PlayerStats/SkillQuickSlot/slot_2"
            )
        end
    end

    method void OnBeginPlay()
        self:EnsureDefaultTextTargets()
        self:UpdateTexts()
    end

    method void OnUpdate(number delta)
        self:UpdateTexts()
    end

    method void UpdateTexts()
        self:EnsureDefaultTextTargets()

        local player = _UserService.LocalPlayer
        if isvalid(player) == false then
            self:WriteText(self.healthLevelTextTarget, "1", "HealthLevel")
            self:WriteText(self.staminaLevelTextTarget, "1", "StaminaLevel")
            self:WriteText(self.attackLevelTextTarget, "1", "AttackLevel")
            return
        end

        local playerComponent = player:GetComponent("PlayerComponent")
        local soulSystem = player:GetComponent("PlayerSoulSystem")

        if isvalid(playerComponent) then
            local hp = math.floor(playerComponent.Hp)
            local maxHp = math.max(1, math.floor(playerComponent.MaxHp))
            local healthText = tostring(hp) .. "/" .. tostring(maxHp)
            if healthText ~= self.LastLoggedHealthText then
                self.LastLoggedHealthText = healthText
            end
            self:WriteText(self.healthTextTarget, healthText, "Health")
        end

        if isvalid(soulSystem) then
            local stamina = math.floor(soulSystem.CurrentStamina)
            local maxStamina = math.max(1, math.floor(soulSystem:GetMaxStamina()))
            local staminaText = tostring(stamina) .. "/" .. tostring(maxStamina)
            if staminaText ~= self.LastLoggedStaminaText then
                self.LastLoggedStaminaText = staminaText
            end
            self:WriteText(self.staminaTextTarget, staminaText, "Stamina")

            local hl = tostring(math.floor(soulSystem.HealthLevel))
            local sl = tostring(math.floor(soulSystem.StaminaLevel))
            local al = tostring(math.floor(soulSystem.AttackLevel))

            if hl ~= self.LastLoggedHealthLevel then
                self.LastLoggedHealthLevel = hl
                self:WriteText(self.healthLevelTextTarget, hl, "HealthLevel")
            end
            if sl ~= self.LastLoggedStaminaLevel then
                self.LastLoggedStaminaLevel = sl
                self:WriteText(self.staminaLevelTextTarget, sl, "StaminaLevel")
            end
            if al ~= self.LastLoggedAttackLevel then
                self.LastLoggedAttackLevel = al
                self:WriteText(self.attackLevelTextTarget, al, "AttackLevel")
            end
        else
            self:WriteText(self.healthLevelTextTarget, "1", "HealthLevel")
            self:WriteText(self.staminaLevelTextTarget, "1", "StaminaLevel")
            self:WriteText(self.attackLevelTextTarget, "1", "AttackLevel")
        end
    end

    method void WriteText(Entity target, string value, string label)
        if isvalid(target) == false then
            return
        end

        if isvalid(target.TextComponent) then
            target.TextComponent.Text = value
            local color = target.TextComponent.FontColor
            if color.a <= 0 then
                target.TextComponent.FontColor = Color(color.r, color.g, color.b, 1)
            end
            return
        end

        if isvalid(target.TextGUIRendererComponent) then
            target.TextGUIRendererComponent.Text = value
            return
        end

        if isvalid(target.TextInputComponent) then
            target.TextInputComponent.Text = value
            return
        end

        local textChild = target:GetFirstChildComponentByTypeName("TextComponent", true)
        if isvalid(textChild) then
            textChild.Text = value
            local color = textChild.FontColor
            if color.a <= 0 then
                textChild.FontColor = Color(color.r, color.g, color.b, 1)
            end
            return
        end

        local textGuiChild = target:GetFirstChildComponentByTypeName("TextGUIRendererComponent", true)
        if isvalid(textGuiChild) then
            textGuiChild.Text = value
            return
        end

        local textInputChild = target:GetFirstChildComponentByTypeName("TextInputComponent", true)
        if isvalid(textInputChild) then
            textInputChild.Text = value
            return
        end
    end

end
