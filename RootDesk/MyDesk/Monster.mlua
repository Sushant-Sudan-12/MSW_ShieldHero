@Component
script Monster extends Component

	@Sync
	property number MaxHp = 100

	@Sync
	property number Hp = 0

	@Sync
	property boolean RespawnOn = false

	@Sync
	@HideFromInspector
	property boolean IsDead = false

	@Sync
	property number RespawnDelay = 5

	@Sync
	property number DestroyDelay = 0.6

	@MinValue(0)
	property number ParryPushbackUnits = 1.8

	@MinValue(0)
	property number ParryStunDuration = 0.2

	@HideFromInspector
	property number ParryStunEndTime = 0

	@HideFromInspector
	property number ParryStunRecoverTimerId = 0

	method void OnBeginPlay()
		self.Hp = self.MaxHp
	end

	@ExecSpace("ServerOnly")
	method void ApplyParryStun(number duration)
		if duration <= 0 then
			return
		end

		local newEndTime = _UtilLogic.ElapsedSeconds + duration
		if newEndTime > self.ParryStunEndTime then
			self.ParryStunEndTime = newEndTime
		end

		local wander = self.Entity.AIWanderComponent
		if isvalid(wander) then
			wander.Enable = false
		end

		local rigidbody = self.Entity.RigidbodyComponent
		if isvalid(rigidbody) then
			rigidbody.MoveVelocity = Vector2.zero
		end

		if self.ParryStunRecoverTimerId ~= 0 then
			_TimerService:ClearTimer(self.ParryStunRecoverTimerId)
			self.ParryStunRecoverTimerId = 0
		end

		self.ParryStunRecoverTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(self.Entity) == false then
				return
			end
			local monster = self.Entity:GetComponent("Monster")
			if isvalid(monster) == false or monster.IsDead then
				return
			end
			local wanderComp = self.Entity.AIWanderComponent
			if isvalid(wanderComp) then
				wanderComp.Enable = true
			end
		end, duration)
	end

	method boolean IsParryStunned()
		return _UtilLogic.ElapsedSeconds < self.ParryStunEndTime
	end

	@ExecSpace("ServerOnly")
	method void Dead()
		self.IsDead = true
		local stateComponent = self.Entity.StateComponent
		if stateComponent then
			stateComponent:ChangeState("DEAD")
			log("monster change state to DEAD")
		end
		
		local delayHide = function()
			-- Never destroy: hide + disable only, so run reset can respawn this monster
			self.Entity:SetVisible(false)
			self.Entity:SetEnable(false)
		end
		
		_TimerService:SetTimerOnce(delayHide, self.DestroyDelay)
	end

	@ExecSpace("ServerOnly")
	method void Respawn()
		log("Respawn")
		self.IsDead = false
		self.Entity:SetVisible(true)
		self.Entity:SetEnable(true)
		
		self.Hp = self.MaxHp
		local stateComponent = self.Entity.StateComponent
		if stateComponent then
			stateComponent:ChangeState("IDLE")
		end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		-- Parameters
		-- local AttackCenter = event.AttackCenter
		-- local AttackerEntity = event.AttackerEntity
		-- local Damages = event.Damages
		-- local Extra = event.Extra
		-- local IsCritical = event.IsCritical
		local TotalDamage = event.TotalDamage
		--------------------------------------------------------
		
		local originalHp = self.Hp
		self.Hp = self.Hp - TotalDamage
		
		if self.Hp > 0 or originalHp <= 0 then
			return	
		end
		
		self:Dead()
		local timerFunc = function() self:Respawn() end
		
		if self.RespawnOn then
			_TimerService:SetTimerOnce(timerFunc, self.RespawnDelay)
		end
	end

end