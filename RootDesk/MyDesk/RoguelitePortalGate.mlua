@Component
script RoguelitePortalGate extends Component

	property PortalComponent Portal = nil

	property string RequiredMonsterTag = "TrialOfMountainMonster"

	property string RequiredProgressId = ""

	@MinValue(1)
	property integer RequiredDefeatedCount = 10

	property boolean UnlockWhenAllTaggedMonstersDefeated = true

	property boolean PersistUnlockAcrossRuns = true

	property string PersistentUnlockStorageName = "RoguelitePortalUnlocks"

	property string PersistentUnlockId = ""

	property boolean ResetPersistentUnlock = false

	property boolean UnlockOverride = false

	@HideFromInspector
	property boolean IsUnlocked = false

	@HideFromInspector
	property boolean FoundRequiredMonster = false

	@HideFromInspector
	property boolean PersistentUnlockLoaded = false

	@HideFromInspector
	property boolean PersistentUnlockStored = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		if isvalid(self.Portal) == false then
			self.Portal = self.Entity.PortalComponent
		end

		self.IsUnlocked = false
		self:ApplyPortalState()
		self:LoadPersistentUnlockState()
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self.ResetPersistentUnlock then
			self:ClearPersistentUnlock()
			self.ResetPersistentUnlock = false
			self.IsUnlocked = false
			self:ApplyPortalState()
			return
		end

		if self.PersistUnlockAcrossRuns and self.PersistentUnlockLoaded == false then
			self:LoadPersistentUnlockState()
			return
		end

		if self.PersistUnlockAcrossRuns and self.PersistentUnlockStored then
			self:UnlockPortal(false)
			return
		end

		local unlockConditionMet = self:IsUnlockConditionMet()
		if self.IsUnlocked then
			if self.PersistUnlockAcrossRuns == false and unlockConditionMet == false then
				self.IsUnlocked = false
				self:ApplyPortalState()
			end
			return
		end

		if self.UnlockOverride then
			self:UnlockPortal(false)
			return
		end

		if unlockConditionMet then
			self:UnlockPortal(self.PersistUnlockAcrossRuns)
		end
	end

	@ExecSpace("ServerOnly")
	method boolean IsUnlockConditionMet()

		if self.UnlockWhenAllTaggedMonstersDefeated == false then
			if self.RequiredProgressId == "" then
				return false
			end
		end

		if self.PersistUnlockAcrossRuns and self.RequiredProgressId ~= "" then
			local users = _UserService.UserEntities
			if users ~= nil then
				for _, player in pairs(users) do
					if isvalid(player) then
						---@type RogueliteRunManager
						local runManager = player:GetComponent("RogueliteRunManager")
						if isvalid(runManager) and runManager:GetDefeatProgress(self.RequiredProgressId) >= self.RequiredDefeatedCount then
							return true
						end
					end
			end
			end
		end

		local monsters = _EntityService:GetEntitiesByTag(self.RequiredMonsterTag)
		if monsters == nil then
			return false
		end

		local defeatedCount = 0
		for _, monsterEntity in ipairs(monsters) do
			if isvalid(monsterEntity) then
				self.FoundRequiredMonster = true
				---@type Monster
				local monster = monsterEntity:GetComponent("Monster")
				if isvalid(monster) and monster.IsDead then
					defeatedCount = defeatedCount + 1
				else
					---@type BossAI
					local boss = monsterEntity:GetComponent("BossAI")
					if isvalid(boss) and boss.IsBossDead then
						defeatedCount = defeatedCount + 1
					else
						---@type IceRockBoss
						local iceRockBoss = monsterEntity:GetComponent("IceRockBoss")
						if isvalid(iceRockBoss) and iceRockBoss.IsBossDead then
							defeatedCount = defeatedCount + 1
						end
					end
				end
			end
		end

		return self.FoundRequiredMonster and defeatedCount >= self.RequiredDefeatedCount
	end

	@ExecSpace("ServerOnly")
	method void UnlockPortal(boolean savePersistentUnlock)
		if self.IsUnlocked then
			return
		end

		self.IsUnlocked = true
		self:ApplyPortalState()
		if savePersistentUnlock then
			self:SavePersistentUnlockForAllPlayers()
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyPortalState()
		if isvalid(self.Portal) then
			self.Portal.Enable = self.IsUnlocked
		end
	end

	method string GetPersistentUnlockKey()
		if self.PersistentUnlockId ~= nil and self.PersistentUnlockId ~= "" then
			return self.PersistentUnlockId
		end

		if self.RequiredProgressId ~= nil and self.RequiredProgressId ~= "" then
			return "PortalUnlock:" .. self.RequiredProgressId
		end

		if self.RequiredMonsterTag ~= nil and self.RequiredMonsterTag ~= "" then
			return "PortalUnlock:" .. self.RequiredMonsterTag
		end

		return "PortalUnlock:" .. tostring(self.Entity.Path)
	end

	@ExecSpace("ServerOnly")
	method void LoadPersistentUnlockState()
		if self.PersistUnlockAcrossRuns == false then
			return
		end

		local storage = _DataStorageService:GetGlobalDataStorage(self.PersistentUnlockStorageName)
		if storage == nil then
			return
		end

		local err, value = storage:GetAndWait(self:GetPersistentUnlockKey())
		self.PersistentUnlockStored = err == 0 and value == "true"
		self.PersistentUnlockLoaded = true
		if self.PersistentUnlockStored then
			self:UnlockPortal(false)
		end
	end

	@ExecSpace("ServerOnly")
	method boolean IsPersistentUnlockSetForAnyPlayer()
		if self.PersistentUnlockLoaded == false then
			self:LoadPersistentUnlockState()
		end

		return self.PersistentUnlockStored
	end

	@ExecSpace("ServerOnly")
	method void SavePersistentUnlockForAllPlayers()
		local storage = _DataStorageService:GetGlobalDataStorage(self.PersistentUnlockStorageName)
		if storage == nil then
			return
		end

		local err = storage:SetAndWait(self:GetPersistentUnlockKey(), "true")
		if err == 0 then
			self.PersistentUnlockStored = true
			self.PersistentUnlockLoaded = true
		end
	end

	@ExecSpace("ServerOnly")
	method void ClearPersistentUnlock()
		local storage = _DataStorageService:GetGlobalDataStorage(self.PersistentUnlockStorageName)
		if storage ~= nil then
			storage:DeleteAndWait(self:GetPersistentUnlockKey())
		end

		self.PersistentUnlockStored = false
		self.PersistentUnlockLoaded = true
	end

	@ExecSpace("ServerOnly")
	method void ClearPersistentUnlockForAllPlayers()
		self:ClearPersistentUnlock()
	end

end
